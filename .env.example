# SERVER-ONLY secrets/config. Never commit a real .env file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atabeh_store?schema=public"
SESSION_COOKIE_NAME="atabeh_session"
SESSION_TTL_DAYS="14"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD"

# Public branding only. NEXT_PUBLIC_* values are visible in the browser by design.
NEXT_PUBLIC_STORE_NAME="Atabeh Royal Carpet"

# Production origins (server-side config; fill these when your domain is ready)
PUBLIC_APP_ORIGIN="https://example.com"
ADMIN_APP_ORIGIN="https://admin.example.com"
# Keep API same-origin initially. If you later move it to api.example.com, configure strict CORS there.
API_APP_ORIGIN="https://example.com"

# Public business WhatsApp number in international format, digits only (example: 9705XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER="972599085646"

# Payment gateway credentials will be SERVER-ONLY. Do not prefix secrets with NEXT_PUBLIC_.
PAYMENT_PROVIDER=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
